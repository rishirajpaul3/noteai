RECALL_API_KEY=your-recall-api-key
RECALL_REGION=us-west-2
# After configuring provider at https://us-west-2.recall.ai/dashboard/transcription
# Options: assembly_ai, gladia, deepgram, aws_transcribe, rev_ai, speechmatics
RECALL_TRANSCRIPTION_PROVIDER=assembly_ai
ANTHROPIC_API_KEY=your-anthropic-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token
WEBHOOK_BASE_URL=https://your-ngrok-or-domain.com
# Set to true to skip AI calls and use fixture BANT data during UI dev
MOCK_BANT=false
